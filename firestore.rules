rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is a member of a group by reading the group document
    // This function can be used when we already have access to the group document
    function isMemberOfGroup(groupData) {
      return isAuthenticated() && 
        request.auth.uid in (groupData.memberIds || []);
    }
    
    // Check if user is organizer of a group by reading the group document
    function isOrganizerOfGroup(groupData) {
      return isAuthenticated() && 
        request.auth.uid == groupData.organizerId;
    }
    
    // Check membership using get() - use carefully to avoid circular dependencies
    function isGroupMember(groupId) {
      return isAuthenticated() && 
        request.auth.uid in (get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.memberIds || []);
    }
    
    function isGroupOrganizer(groupId) {
      return isAuthenticated() && 
        request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId;
    }
    
    // Check if user is organizer or co-organizer (has role='organizer' in members subcollection)
    function isOrganizerOrCoOrganizer(groupId) {
      return isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId ||
        exists(/databases/$(database)/documents/gamingGroups/$(groupId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/gamingGroups/$(groupId)/members/$(request.auth.uid)).data.role == 'organizer'
      );
    }
    
    // Users can read/write their own profile
    // Allow any authenticated user to read any user profile (for displaying member info in groups)
    match /users/{userId} {
      // Allow read for any authenticated user - needed for displaying member profiles in groups
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated(); // Anyone can create notifications for a user
        allow update, delete: if isOwner(userId);
      }
      
      // Photo upload tracking subcollection - tracks monthly photo uploads per user
      match /photoUploads/{yearMonth} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(userId);
        allow delete: if false; // Don't allow deletion of tracking data
      }
    }
    
    // Gaming Groups
    match /gamingGroups/{groupId} {
      // Helper function to check if user can read a group
      // For queries, get() works server-side to check document data
      function canReadGroup() {
        // If user has a member document, they can read the group (most reliable check, doesn't require group read)
        // Otherwise, check group document data using get() (works server-side for both queries and direct reads)
        return exists(/databases/$(database)/documents/gamingGroups/$(groupId)/members/$(request.auth.uid)) ||
               (request.auth.uid in (get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.memberIds || [])) ||
               (request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId) ||
               (get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.isActive != false && 
                get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.deletedAt == null);
      }
      
      // Allow reading if authenticated AND user can read the group
      // This works for both direct reads and queries
      allow read: if isAuthenticated() && canReadGroup();
      allow create: if isAuthenticated();
      // Allow organizers to update/delete, or allow users to add themselves to memberIds when joining
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.organizerId ||
        isOrganizerOrCoOrganizer(groupId) ||
        // Allow users to add themselves to memberIds when joining via join code
        // Check that only memberIds and updatedAt are being modified
        // and that the user is in the new memberIds
        // Also verify the group is active (has a valid join code scenario)
        // Note: We allow this even if user is already in memberIds to handle edge cases
        // where memberIds exists but member document doesn't, or vice versa
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt']) &&
         request.auth.uid in (request.resource.data.memberIds || []) &&
         // Ensure group is active (allows join code flow)
         request.resource.data.isActive != false &&
         request.resource.data.deletedAt == null)
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.organizerId ||
        isOrganizerOrCoOrganizer(groupId)
      );
      
      // Group members - allow members to update their own member document (including RSVP fields)
      match /members/{userId} {
        // Allow reading if user is authenticated and either:
        // - They are reading their own member document, OR
        // - They have a member document (they're a member), OR
        // - They are a member of the group (in memberIds) OR the organizer, OR
        // - The group is active (enables join code flow - users joining need to see members)
        function isGroupMemberOrOrganizer() {
          // Option 1: Check if current user has a member document (most reliable, doesn't require group read)
          // If user has a member document, they're definitely a member and can read all members
          // exists() doesn't require read permission, so this works even if user can't read the group
          // This handles the case where user joined but Firestore update to memberIds failed
          // IMPORTANT: Check exists() first - if user has member doc, they can read all members
          // This avoids needing to call get() on the group document, which might fail
          let hasMemberDoc = exists(/databases/$(database)/documents/gamingGroups/$(groupId)/members/$(request.auth.uid));
          
          // Option 2: Check group document for membership, organizer status, or active status
          // get() in security rules is evaluated server-side and should work even if user can't read directly
          // However, if the group document doesn't exist or has restrictions, get() might fail
          // We structure this so that if hasMemberDoc is true, we return true via logical OR
          // But Firestore rules evaluate all expressions, so get() might still be called
          // To avoid get() failing, we need to ensure it only runs when necessary
          // Actually, the issue is that get() might fail if the group document can't be read
          // But get() in security rules should work server-side even if user can't read the document
          // So the real issue might be that the group document doesn't exist or is deleted
          let groupDoc = get(/databases/$(database)/documents/gamingGroups/$(groupId));
          let memberIds = groupDoc.data.memberIds || [];
          let isActive = groupDoc.data.isActive != false && groupDoc.data.deletedAt == null;
          
          // Return true if user has member doc OR is in memberIds OR is organizer OR group is active
          // The logical OR means if hasMemberDoc is true, we return true
          // But Firestore rules evaluate all expressions, so get() is still called
          // If get() fails, the entire rule fails, even if hasMemberDoc is true
          // This is a limitation of Firestore rules - we can't short-circuit evaluation
          return hasMemberDoc ||
                 request.auth.uid in memberIds ||
                 request.auth.uid == groupDoc.data.organizerId ||
                 // Allow reading members if group is active (enables join code flow)
                 // Users joining via join code need to see existing members before they're added to memberIds
                 // This matches the group read rule which allows reading active groups
                 isActive;
        }
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          // If user has a member document, they can read all members
          // This check doesn't require reading the group document, so it works even if user can't read the group
          exists(/databases/$(database)/documents/gamingGroups/$(groupId)/members/$(request.auth.uid)) ||
          // Otherwise, check group document for membership, organizer status, or active status
          isGroupMemberOrOrganizer()
        );
        // Allow users to create their own member document when joining
        // This allows users to join events by creating their own membership
        // The isOwner check ensures users can only create their own member document
        // Note: Organizers adding members should update memberIds array directly, not create member docs
        allow create: if isAuthenticated() && isOwner(userId);
        // Allow members to update their own member document (including rsvpStatus, rsvpStatuses, rsvpUpdatedAt)
        // Organizers and co-organizers can update any member's data
        allow update: if isAuthenticated() && (
          isOwner(userId) ||
          isOrganizerOrCoOrganizer(groupId)
        );
        allow delete: if isAuthenticated() && (
          isOwner(userId) ||
          isOrganizerOrCoOrganizer(groupId)
        );
      }
      
      // Discussion Forum Posts
      match /posts/{postId} {
        // Helper function to check if user can access posts
        // Check membership via member document first (doesn't require group read)
        // Then fall back to checking group document memberIds/organizerId
        function canAccessPosts() {
          // Check if user has a member document (most reliable, doesn't require group read)
          return exists(/databases/$(database)/documents/gamingGroups/$(groupId)/members/$(request.auth.uid)) ||
                 // Otherwise check group document (requires read permission)
                 (request.auth.uid in (get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.memberIds || [])) ||
                 (request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId);
        }
        allow read: if isAuthenticated() && canAccessPosts();
        allow create: if isAuthenticated() && canAccessPosts();
        allow update, delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isOrganizerOrCoOrganizer(groupId)
        );
        
        // Post Comments
        match /comments/{commentId} {
          allow read: if isAuthenticated() && canAccessPosts();
          allow create: if isAuthenticated() && canAccessPosts();
          allow update, delete: if isAuthenticated() && (
            resource.data.userId == request.auth.uid ||
            request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId
          );
        }
      }
      
      // Game Interests
      match /gameInterests/{interestId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in (get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.memberIds || []) ||
          request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId
        );
        allow create: if isAuthenticated() && 
          request.auth.uid in (get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.memberIds || []);
        allow update: if isAuthenticated() && (
          resource.data.ownerId == request.auth.uid ||
          resource.data.interestedUserId == request.auth.uid ||
          request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId
        );
        allow delete: if isAuthenticated() && (
          resource.data.interestedUserId == request.auth.uid ||
          request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId
        );
      }
      
      // Game Status (which games users are bringing/want-to-play)
      match /gameStatus/{statusId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in (get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.memberIds || []) ||
          request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId
        );
        allow create: if isAuthenticated() && 
          request.auth.uid in (get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.memberIds || []) &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId
        ) && (
          request.resource.data.userId == resource.data.userId
        );
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId
        );
      }
      
      // Game Proposals/Nominations
      // Documents can be either:
      // 1. Proposal documents: document ID = gameId, has nominatedBy field
      // 2. Rating documents: document ID = gameId_userId, has userId and rating fields
      match /nominations/{proposalId} {
        // Check if user has a member document (most reliable, doesn't require group read)
        function hasMemberDocument() {
          return exists(/databases/$(database)/documents/gamingGroups/$(groupId)/members/$(request.auth.uid));
        }
        
        allow read: if isAuthenticated() && (
          // If member document exists, allow read (doesn't require group read)
          hasMemberDocument() ||
          // Otherwise check group document (requires read permission)
          (request.auth.uid in (get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.memberIds || [])) ||
          (request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId)
        );
        
        allow create: if isAuthenticated() && 
          // Check membership - member document must exist
          // This is the primary and most reliable check
          hasMemberDocument() &&
          (
            // Ensure the nominatedBy or userId matches the authenticated user
            // For proposal documents (has nominatedBy field), ensure nominatedBy matches authenticated user
            (request.resource.data.nominatedBy != null && request.resource.data.nominatedBy == request.auth.uid) ||
            // For rating documents (has userId field), ensure userId matches authenticated user
            (request.resource.data.userId != null && request.resource.data.userId == request.auth.uid)
          );
        
        allow update, delete: if isAuthenticated() && (
          // Allow if user is the one who proposed (proposal documents)
          resource.data.proposedBy == request.auth.uid ||
          resource.data.nominatedBy == request.auth.uid ||
          // Allow if user is the one who rated (rating documents)
          resource.data.userId == request.auth.uid ||
          // Allow organizer to update/delete any nomination
          request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId
        );
      }

      // Match Scores - Match Scores for games
      match /matchScores/{gameId} {
        // Helper function to check if user can access match scores
        function canAccessMatchScores() {
          // Check if user has a member document (most reliable, doesn't require group read)
          return exists(/databases/$(database)/documents/gamingGroups/$(groupId)/members/$(request.auth.uid)) ||
                 // Otherwise check group document (requires read permission)
                 (request.auth.uid in (get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.memberIds || [])) ||
                 (request.auth.uid == get(/databases/$(database)/documents/gamingGroups/$(groupId)).data.organizerId);
        }
        
        // Allow members to read match scores for all games in the group
        allow read: if isAuthenticated() && canAccessMatchScores();
        
        // Allow members to create/update match scores (for calculation)
        allow create, update: if isAuthenticated() && canAccessMatchScores();
        
        // Don't allow deletion (scores should be recalculated, not deleted)
        allow delete: if false;
      }

      // Private conversations between members
      match /privateConversations/{conversationId} {
        function conversationDoc() {
          return get(/databases/$(database)/documents/gamingGroups/$(groupId)/privateConversations/$(conversationId));
        }
        // Helper to check if a participant is Beeple (system bot)
        function isBeeple(participantId) {
          return participantId == 'beeple';
        }
        // Check if user can access an existing conversation (for read/update/delete)
        function canAccessExistingConversation() {
          let participants = conversationDoc().data.participants || [];
          // Allow if user is a group member AND (user is in participants OR conversation includes Beeple)
          return isGroupMember(groupId) && (
            request.auth.uid in participants ||
            isBeeple(participants[0]) || isBeeple(participants[1])
          );
        }
        // Check if user can create a conversation (for create operations)
        function canCreateConversation() {
          let participants = request.resource.data.participants || [];
          // Allow if user is a group member AND one participant is Beeple
          // This allows members to create conversations with Beeple
          return isGroupMember(groupId) && (
            isBeeple(participants[0]) || isBeeple(participants[1])
          );
        }
        allow read: if isAuthenticated() && canAccessExistingConversation();
        // Allow creating conversations if user is a group member AND one participant is Beeple
        allow create: if isAuthenticated() && canCreateConversation();
        allow update, delete: if isAuthenticated() && canAccessExistingConversation();

        // Messages inside a conversation
        match /messages/{messageId} {
          function canAccessMessages() {
            let participants = conversationDoc().data.participants || [];
            // Allow if user is a group member AND (user is in participants OR conversation includes Beeple)
            return isGroupMember(groupId) && (
              request.auth.uid in participants ||
              'beeple' in participants
            );
          }
          // Allow reading if user can access the conversation
          allow read: if isAuthenticated() && canAccessMessages();
          // Allow creating messages if:
          // - User can access messages AND
          // - (sender is authenticated user OR sender is Beeple - allowing members to send as Beeple)
          allow create: if isAuthenticated() && canAccessMessages() && (
            request.resource.data.senderId == request.auth.uid ||
            request.resource.data.senderId == 'beeple'
          );
          // Allow sender to edit their message, or participants to mark read only
          allow update: if isAuthenticated() && canAccessMessages() &&
            (
              resource.data.senderId == request.auth.uid ||
              (
                request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']) &&
                request.resource.data.senderId == resource.data.senderId &&
                request.resource.data.content == resource.data.content &&
                request.resource.data.createdAt == resource.data.createdAt
              )
            );
          allow delete: if isAuthenticated() && canAccessMessages() &&
            resource.data.senderId == request.auth.uid;
        }
      }
    }
    
    // Games (read-only for most users, anyone can create)
    match /games/{gameId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // Could restrict to admins
    }
    
    // User Games
    match /userGames/{userId}/games/{gameId} {
      allow read: if isAuthenticated(); // Members can see each other's games in groups
      allow write: if isOwner(userId);
    }
    
    // Availability Profiles
    match /availabilityProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
  }
}

