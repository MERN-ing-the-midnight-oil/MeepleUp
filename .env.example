# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your apps > Web app
# Required for Firebase Authentication, Firestore, and Storage
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=meepleup-951a1.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=meepleup-951a1
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=meepleup-951a1.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=177622732549
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Alternative: React App environment variables (for web builds)
# REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
# REACT_APP_FIREBASE_AUTH_DOMAIN=meepleup-951a1.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=meepleup-951a1
# REACT_APP_FIREBASE_STORAGE_BUCKET=meepleup-951a1.firebasestorage.app
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=177622732549
# REACT_APP_FIREBASE_APP_ID=your_firebase_app_id_here

# Board Game Geek (BGG) API Token (optional)
# Get from: https://boardgamegeek.com/wiki/page/BGG_XML_API2
EXPO_PUBLIC_BGG_API_TOKEN=your_bgg_api_token_here
# REACT_APP_BGG_API_TOKEN=your_bgg_api_token_here

# Anthropic/Claude API Key (for game identification feature)
# Get from: https://console.anthropic.com/
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key_here
# REACT_APP_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Model (optional, defaults to claude-3-haiku-20240307)
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-3-haiku-20240307

# RapidAPI Key (optional, for archived barcode scanning feature)
EXPO_PUBLIC_RAPIDAPI_KEY=your_rapidapi_key_here
# REACT_APP_RAPIDAPI_KEY=your_rapidapi_key_here

# Email Configuration (optional, if using email features)
EXPO_PUBLIC_EMAIL_USER=your_email_here
EXPO_PUBLIC_EMAIL_PASS=your_email_password_here
# REACT_APP_EMAIL_USER=your_email_here
# REACT_APP_EMAIL_PASS=your_email_password_here

# IMPORTANT SECURITY NOTES:
# 1. Never commit your .env file to version control (it's in .gitignore)
# 2. Regenerate any exposed API keys immediately
# 3. Use EXPO_PUBLIC_ prefix for Expo projects (these are accessible in client-side code)
# 4. For server-side only secrets, use variables WITHOUT the EXPO_PUBLIC_ prefix
# 5. Add API key restrictions in Google Cloud Console for Firebase API keys
