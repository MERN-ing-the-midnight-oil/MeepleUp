{
  "name": "MeepleUp",
  "version": "1.0.10",
  "description": "A platform for managing board game events and collections.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "copy:email-verified": "node scripts/copy-email-verified.js",
    "build:web": "expo export && npm run copy:email-verified",
    "build:ios:local": "eas build --platform ios --profile preview --local",
    "build:ios:preview": "eas build --platform ios --profile preview --local",
    "build:ios:production": "eas build --platform ios --profile production --local",
    "build:ios:store": "eas build --platform ios --profile production --auto-submit",
    "build:android:store": "eas build --platform android --profile production --auto-submit",
    "build:all:store": "eas build --platform all --profile production --auto-submit",
    "submit:ios": "eas submit --platform ios --profile production",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "keywords": [
    "react-native",
    "expo",
    "board games",
    "events",
    "collection management"
  ],
  "author": "Rhys Smoker",
  "license": "MIT",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "axios": "^1.6.2",
    "expo": "~54.0.31",
    "expo-apple-authentication": "^8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "fast-xml-parser": "^4.5.3",
    "firebase": "^9.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/react-native": "^12.4.3",
    "@types/node": "^25.0.3",
    "@types/react": "~19.1.10",
    "dotenv": "^17.2.3",
    "firebase-admin": "^13.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-expo": "~52.0.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "watchman": false,
    "transformIgnorePatterns": [
      "node_modules/(?!(@react-native|react-native|expo)/)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-native$": "<rootDir>/__mocks__/react-native.js"
    }
  }
}
