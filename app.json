{
  "expo": {
    "name": "MeepleUp",
    "slug": "meepleup",
    "scheme": "meepleup",
    "version": "1.0.2",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/app-icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "23",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow MeepleUp to access your photo library to select game images.",
        "NSPhotoLibraryAddUsageDescription": "Allow MeepleUp to save images to your photo library.",
        "NSMicrophoneUsageDescription": "Allow MeepleUp to access your microphone to record audio narration when taking photos of games."
      }
    },
    "android": {
      "versionCode": 28,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.meepleup.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MeepleUp to access your camera to scan barcodes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MeepleUp to access your location to find nearby game events."
        }
      ],
      "expo-web-browser",
      [
        "expo-apple-authentication",
        {
          "appleTeamId": "5C646HCA5F"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "5137a654-4dbf-4ef8-8a77-2458f23d880e"
      }
    },
    "owner": "rhyssmoker"
  }
}
